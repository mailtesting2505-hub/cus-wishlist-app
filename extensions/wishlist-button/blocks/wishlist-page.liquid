{% comment %}Wishlist Page Block{% endcomment %}

<div class="wishlist-page" id="wishlist-page">
  <div class="wishlist-page-header">
    <h1>💝 My Wishlist</h1>
    {% if customer %}
      <p class="wishlist-subtitle">Hello, {{ customer.first_name }}!</p>
    {% else %}
      <div class="wishlist-auth-banner">
        <p>Please <a href="{{ routes.account_login_url }}">log in</a> or <a href="{{ routes.account_register_url }}">sign up</a> to view your wishlist.</p>
      </div>
    {% endif %}
  </div>
  {% if customer %}
  <div id="wl-con">
    <div class="wl-loading"><div class="wl-spin"></div><p>Loading...</p></div>
  </div>
  {% endif %}
</div>

<div class="wl-toast" id="wlt"></div>

<style>
.wishlist-page{max-width:1200px;margin:0 auto;padding:40px 20px}
.wishlist-page-header{text-align:center;margin-bottom:48px}
.wishlist-page-header h1{font-size:36px;font-weight:700;color:#222}
.wishlist-subtitle{color:#666;font-size:16px}
.wishlist-auth-banner{background:#fce4ec;border:1px solid #f48fb1;border-radius:12px;padding:24px;margin:24px auto;max-width:500px;font-size:16px}
.wishlist-auth-banner a{color:#e91e63;font-weight:600;text-decoration:none}
.wl-loading{display:flex;flex-direction:column;align-items:center;padding:80px 20px;color:#999}
.wl-spin{width:40px;height:40px;border:3px solid #f0f0f0;border-top-color:#e91e63;border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:16px}
@keyframes spin{to{transform:rotate(360deg)}}
.wl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px}
.wl-card{background:#fff;border:1px solid #eee;border-radius:16px;overflow:hidden;transition:all 0.3s}
.wl-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,0.1)}
.wl-img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
.wl-info{padding:16px}
.wl-title{font-size:15px;font-weight:600;color:#222;margin:0 0 8px}
.wl-price{font-size:16px;color:#e91e63;font-weight:700;margin-bottom:16px}
.wl-actions{display:flex;gap:8px}
.wl-view{flex:1;padding:10px 16px;background:#222;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;text-decoration:none;text-align:center}
.wl-remove{padding:10px 14px;background:#fff;color:#e91e63;border:1px solid #e91e63;border-radius:8px;cursor:pointer}
.wl-empty{text-align:center;padding:80px 20px}
.wl-empty-icon{font-size:64px;margin-bottom:24px}
.wl-empty h2{font-size:24px;color:#333;margin-bottom:12px}
.wl-empty p{color:#666;margin-bottom:32px}
.wl-shop{display:inline-block;padding:14px 32px;background:#e91e63;color:#fff;text-decoration:none;border-radius:50px;font-weight:600}
.wl-toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:#333;color:#fff;padding:14px 28px;border-radius:50px;font-size:14px;z-index:99999;display:none}
</style>

<script>
(function(){
  {% if customer %}
  var APP_URL = {{ block.settings.app_url | json }};
  var SHOP = {{ shop.permanent_domain | json }};
  var CID = {{ customer.id | json }};
  var con = document.getElementById('wl-con');

  function toast(m){
    var t = document.getElementById('wlt');
    t.textContent = m;
    t.style.display = 'block';
    setTimeout(function(){ t.style.display = 'none'; }, 3000);
  }

  async function removeItem(id, el){
    var r = await fetch(APP_URL + '/api/wishlist/' + id, {
      method: 'DELETE',
      headers: { 'X-Shopify-Shop': SHOP, 'X-Customer-Id': CID }
    });
    var d = await r.json();
    if(d.success){
      el.style.opacity = '0';
      el.style.transition = 'all 0.3s';
      setTimeout(function(){
        el.remove();
        if(!document.querySelector('.wl-card')) showEmpty();
      }, 300);
      toast('Removed from wishlist');
    }
  }

  function showEmpty(){
    con.innerHTML = '<div class="wl-empty"><div class="wl-empty-icon">💔</div><h2>Your wishlist is empty</h2><p>Explore our store and add products you love!</p><a href="/collections/all" class="wl-shop">Shop Now</a></div>';
  }

  function renderItems(items){
    if(!items || !items.length){ showEmpty(); return; }
    var grid = document.createElement('div');
    grid.className = 'wl-grid';
    items.forEach(function(item){
      var card = document.createElement('div');
      card.className = 'wl-card';
      card.innerHTML = '<a href="/products/' + item.productHandle + '"><img class="wl-img" src="' + (item.productImage||'') + '" alt="' + item.productTitle + '" loading="lazy"/></a><div class="wl-info"><p class="wl-title"><a href="/products/' + item.productHandle + '" style="color:inherit;text-decoration:none">' + item.productTitle + '</a></p><p class="wl-price">' + (item.productPrice ? '$'+item.productPrice : '') + '</p><div class="wl-actions"><a href="/products/' + item.productHandle + '" class="wl-view">View Product</a><button class="wl-remove">Remove</button></div></div>';
      card.querySelector('.wl-remove').addEventListener('click', function(){ removeItem(item.productId, card); });
      grid.appendChild(card);
    });
    con.innerHTML = '';
    con.appendChild(grid);
  }

  fetch(APP_URL + '/api/wishlist', {
    headers: { 'X-Shopify-Shop': SHOP, 'X-Customer-Id': CID }
  }).then(function(r){ return r.json(); })
    .then(function(d){ renderItems(d.data || []); })
    .catch(function(){ con.innerHTML = '<p style="text-align:center;color:#999;padding:40px">Failed to load. Please refresh.</p>'; });
  {% endif %}
})();
</script>

{% schema %}
{
  "name": "Wishlist Page",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://your-app-url.com"
    }
  ]
}
{% endschema %}
